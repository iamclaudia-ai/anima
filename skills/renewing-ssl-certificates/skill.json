{
  "id": "renewing-ssl-certificates",
  "description": "Renew the SSL2BUY/Sectigo wildcard certs (*.kiliman.dev, *.anima-sedes.com) for Caddy: CSR, Cloudflare DCV CNAME, fullchain, install, reload.",
  "commands": {
    "make-csr": {
      "script": "scripts/make-csr.sh",
      "runtime": "bash",
      "longRunning": false,
      "description": "Generate (or reuse) the RSA key and a CN-only CSR, copy it to the clipboard, print the expected DCV hashes.",
      "args": [
        {
          "name": "workdir",
          "type": "absolute-folder",
          "required": true,
          "description": "e.g. ~/certs/renewal-2027-04"
        },
        {
          "name": "domain",
          "type": "string",
          "required": true,
          "description": "kiliman.dev | anima-sedes.com"
        }
      ],
      "timeoutMs": 30000
    },
    "add-dcv-cname": {
      "script": "scripts/add-dcv-cname.sh",
      "runtime": "bash",
      "longRunning": false,
      "description": "Check the CA's DCV CNAME against the CSR hashes, create it in Cloudflare, wait for public resolution.",
      "args": [
        { "name": "workdir", "type": "absolute-folder", "required": true },
        { "name": "domain", "type": "string", "required": true },
        {
          "name": "cname-host",
          "type": "string",
          "required": true,
          "description": "_<MD5>.<domain>"
        },
        {
          "name": "cname-value",
          "type": "string",
          "required": true,
          "description": "<SHA>.<SHA>.<token>.sectigo.com"
        }
      ],
      "timeoutMs": 120000
    },
    "build-bundle": {
      "script": "scripts/build-bundle.sh",
      "runtime": "bash",
      "longRunning": false,
      "description": "Unzip the issued cert, build fullchain.cer in issuer order, verify key match and chain.",
      "args": [
        { "name": "workdir", "type": "absolute-folder", "required": true },
        { "name": "domain", "type": "string", "required": true },
        {
          "name": "zip",
          "type": "absolute-file",
          "required": true,
          "description": "<order>.zip downloaded from SSL2BUY"
        }
      ],
      "timeoutMs": 30000
    },
    "stage": {
      "script": "scripts/stage.sh",
      "runtime": "bash",
      "longRunning": false,
      "description": "Copy the bundle to the target host (scp for Sedes) and print the one sudo command Michael runs.",
      "args": [
        { "name": "workdir", "type": "absolute-folder", "required": true },
        { "name": "domain", "type": "string", "required": true }
      ],
      "timeoutMs": 60000
    },
    "reload-verify": {
      "script": "scripts/reload-verify.sh",
      "runtime": "bash",
      "longRunning": false,
      "description": "Force-reload Caddy, clear staged files, and confirm every host serves a cert with 30+ days left.",
      "args": [{ "name": "domain", "type": "string", "required": true }],
      "timeoutMs": 60000
    }
  }
}
