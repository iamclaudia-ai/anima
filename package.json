{
  "name": "anima",
  "private": true,
  "workspaces": [
    "packages/*",
    "clients/*",
    "extensions/*"
  ],
  "scripts": {
    "dev": "bun run --filter @anima/gateway dev",
    "restart": "lsof -ti:30086 | xargs kill -9 2>/dev/null; sleep 0.5 && bun run dev",
    "watchdog": "bun run packages/watchdog/src/index.ts",
    "watchdog:deploy": "bun run --filter @anima/watchdog deploy",
    "watchdog:reload": "bun run watchdog:deploy && anima watchdog reload",
    "cli": "bun run packages/cli/src/index.ts",
    "migrate:anima": "bun run scripts/migrate-to-anima.ts",
    "deps:catalog": "bun run scripts/bump-catalog-dependency.ts",
    "deps:outdated": "bun run scripts/outdated-report.ts",
    "deps:drift": "bun run scripts/check-dependency-drift.ts",
    "deps:drift:check": "bun run scripts/check-dependency-drift.ts --fail-on-drift",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text",
    "test:coverage:lcov": "bun test --coverage --coverage-reporter=lcov --coverage-dir coverage",
    "test:unit": "bun test packages/cli/src/index.test.ts packages/cli/src/extension-cli.test.ts extensions/skills/src/inventory.test.ts extensions/skills/src/placement.test.ts packages/gateway/src/extensions.test.ts packages/ui/src/components/layout-flatten.test.ts extensions/control/src/index.test.ts extensions/editor/src/index.test.ts",
    "test:integration": "bun test packages/gateway/src/extensions.integration.test.ts",
    "test:smoke": "bun run scripts/smoke.ts",
    "test:e2e": "bun run scripts/e2e-smoke.ts",
    "test:smoke-all": "bun run test:unit && bun run test:integration && bun run test:smoke",
    "test:ios": "cd clients/ios && swift test",
    "typecheck": "tsgo --noEmit",
    "typecheck:all": "bun run --filter @anima/cli typecheck && bun run --filter @anima/gateway typecheck && bun run --filter @anima/shared typecheck && bun run --filter @anima/ui typecheck && bun run --filter @anima/ext-chat typecheck && bun run --filter @anima/ext-imessage typecheck && bun run --filter @anima/ext-control typecheck && bun run --filter @anima/voice typecheck && bun run --filter @anima/ios typecheck && bun run --filter @anima/menubar typecheck && bun run --filter anima typecheck",
    "precommit": "bun run typecheck && bunx lint-staged",
    "prepush": "bun run typecheck && bun run test:unit && bun run test:ios && bun run docs:api:check && bun run react-doctor:diff",
    "react-doctor": "NO_COLOR=1 react-doctor -y --offline",
    "react-doctor:diff": "NO_COLOR=1 react-doctor -y --scope changed --base origin/main --blocking error --offline",
    "react-doctor:staged": "NO_COLOR=1 react-doctor -y --staged --blocking error --offline",
    "prepare": "husky",
    "lint": "oxlint .",
    "format": "bunx oxfmt --write .",
    "docs:api": "bun run scripts/generate-api-reference.ts && bun run format",
    "docs:api:check": "bun run docs:api && (git diff --quiet -- docs/API-REFERENCE.md && git diff --cached --quiet -- docs/API-REFERENCE.md || (echo \"[prepush] docs/API-REFERENCE.md changed after generation. Commit the regenerated file.\"; exit 1))"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@google/genai": "1.46.0",
    "dockview": "5.1.0",
    "dockview-react": "5.1.0",
    "fuzzysort": "4.0.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/turndown": "5.0.6",
    "@typescript/native-preview": "catalog:",
    "bun-plugin-tailwind": "catalog:",
    "bun-types": "1.4.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "react-doctor": "0.9.18",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "uuid": "11.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "bunx oxfmt --write",
      "oxlint"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "bunx oxfmt --write"
    ]
  },
  "catalog": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "@anthropic-ai/sdk": "0.93.0",
    "@tailwindcss/typography": "0.5.20",
    "@typescript/native-preview": "7.0.0-dev.20260523.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "zod": "4.6.7",
    "@types/node": "25.9.9",
    "react-markdown": "10.1.0",
    "lucide-react": "0.563.0"
  },
  "reactDoctor": {
    "ignore": {
      "rules": [
        "react-doctor/design-no-default-tailwind-palette",
        "react-doctor/design-no-em-dash-in-jsx-text",
        "react-doctor/js-combine-iterations",
        "react-doctor/no-generic-handler-names",
        "react-doctor/design-no-three-period-ellipsis",
        "react-doctor/no-gray-on-colored-background",
        "react-doctor/rerender-state-only-in-handlers"
      ]
    }
  }
}
